# Node
node_modules/
dist/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Env & OS
.env
.env.local
.DS_Store

# Local tooling
# launch.json points the dev-server tooling at the Vite server; it is a
# per-machine convenience, not part of the app.
.claude/

# Superpowers SDD scratch (ledger, briefs, review packages)
.superpowers/

# Build-time snapshot of the public collection, written by
# frontend/scripts/fetch-snapshot.mjs. Fetched per build, never committed:
# unpublishing an item should not leave it in git history.
frontend/public/snapshot/
frontend/public/search-index.json

# Design mockups shared between Code and Cowork; disposable once the UI exists.
docs/planning/mockups/

# The collection export (backend/scripts/export_picker_fixture.py): anonymised,
# but matchable back to real games, so it stays local. Its tests skip without it.
backend/tests/fixtures/picker_collection.json
# Trip photo originals as they come off a camera or a partner's phone. The
# resized output under frontend/public/travel/ is committed instead (it is the
# only build product in public/ that is), and so is photos.json: names, dates,
# date confidence, dimensions and the kid flag are source of truth, not output.
# Originals stay out because git keeps a blob forever, GPS and all.
frontend/trips/*/photos/*
!frontend/trips/*/photos/photos.json
# And any image or video anywhere else under trips/, in either case, for an
# original dropped beside the markdown by mistake. Linux git matches case
# exactly, so the classes spell out what macOS's core.ignorecase hides.
frontend/trips/**/*.[jJ][pP][gG]
frontend/trips/**/*.[jJ][pP][eE][gG]
frontend/trips/**/*.[pP][nN][gG]
frontend/trips/**/*.[hH][eE][iI][cC]
frontend/trips/**/*.[hH][eE][iI][fF]
frontend/trips/**/*.[wW][eE][bB][pP]
frontend/trips/**/*.[tT][iI][fF]
frontend/trips/**/*.[tT][iI][fF][fF]
frontend/trips/**/*.[gG][iI][fF]
frontend/trips/**/*.[dD][nN][gG]
frontend/trips/**/*.[mM][oO][vV]
frontend/trips/**/*.[mM][pP]4

# Playwright output (frontend/e2e)
frontend/test-results/
frontend/playwright-report/
frontend/e2e-shots/
frontend/playwright-report-admin/
frontend/e2e/.auth/
