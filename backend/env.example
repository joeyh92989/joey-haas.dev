# Copy to backend/.env and fill in. .env is gitignored and must never be committed.
#   cp backend/env.example backend/.env
#
# Create the OAuth client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=
# The single Google account allowed to sign in at /admin.
ADMIN_EMAIL=
FRONTEND_URL=http://localhost:5173
# Optional hardening. Set after the first successful sign-in; the server logs
# the value. Once set, both email and sub must match.
ADMIN_GOOGLE_SUB=

# From the Neon console. These are NOT interchangeable: the app uses the pooled
# hostname (contains -pooler), Alembic uses the direct one. Neon's pooler runs
# PgBouncer in transaction mode, which does not support the SET statements
# migrations rely on.
DATABASE_URL=
DATABASE_URL_DIRECT=

# --- Media tracker ---
#
# Every variable below is OPTIONAL and checked lazily, never at boot. A missing
# one disables that one media type or feature; it does not stop the service
# starting. See backend/sources/README.md.
#
# main.py logs which sources are configured at startup -- if one you expect is
# absent from that line, its variable here is wrong.

# TMDB v4 API Read Access Token. Films.
TMDB_API_TOKEN=

# Twitch dev app credentials for IGDB. Video games.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ComicVine API key. Comics, at volume (series) level.
COMICVINE_API_KEY=

# BoardGameGeek. Not usable yet: BGG stopped serving its XML API anonymously
# in late 2025 and now requires a registered application. Setting this alone
# does not enable board games -- the response parsing is still unwritten. See
# backend/sources/bgg.py.
BGG_TOKEN=

# Photo import, and later the recommendation engine: "gemini" or "anthropic".
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
