# Copy to backend/.env and fill in. .env is gitignored and must never be committed.
#   cp backend/env.example backend/.env
#
# Create the OAuth client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=
# The single Google account allowed to sign in at /admin.
ADMIN_EMAIL=
FRONTEND_URL=http://localhost:5173
# Optional hardening. Set after the first successful sign-in; the server logs
# the value. Once set, both email and sub must match.
ADMIN_GOOGLE_SUB=

# From the Neon console. These are NOT interchangeable: the app uses the pooled
# hostname (contains -pooler), Alembic uses the direct one. Neon's pooler runs
# PgBouncer in transaction mode, which does not support the SET statements
# migrations rely on.
DATABASE_URL=
DATABASE_URL_DIRECT=

# --- Media tracker (docs/media-tracker-requirements.md) ---
# TMDB v4 API Read Access Token (E2)
TMDB_API_TOKEN=
# Twitch dev app credentials for IGDB (E3)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# ComicVine API key (E4)
COMICVINE_API_KEY=
# Recommendations (E6): "gemini" or "anthropic"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
