    {
      "id": 8180743897141,
      "title": "Tyrant's Blessing Standard Edition (Switch)",
      "handle": "tyrants-blessing-standard-edition-switch",
      "body_html": "<p><em>Tyrant's Blessing is region-free. This is an open pre-order for a limited time.</em></p>\n<ul></ul>\n<ul></ul>\n<p><strong>PRE-ORDERS CLOSE ON SUNDAY, SEPTEMBER 6, 2025, AT 11:59 PM EASTERN TIME.</strong></p>\n<div>\n<p class=\"p2\">Tyrant's Blessing is a tactical turn-based game where your ability to plan, adapt, and strategize is more important than min-maxing your units or finding the sharpest sword in the hoard. Select battles every day, make challenging choices, and cleverly use the strengths of these rag-tag insurgents to defeat the undead hordes and maybe - just maybe - bring real life back to Tyberia.</p>\n</div>\n<div><br></div>\n<div><br></div>\n<div>\n<div><br></div>\n</div>\n<div>\n<div>\n<div>\n<h6><br></h6>\n<br>\n</div>\n</div>\n</div>",
