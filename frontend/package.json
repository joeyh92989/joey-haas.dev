{
  "name": "joey-haas-dev-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/fetch-snapshot.mjs && node scripts/build-search-index.mjs && vite build && node scripts/prerender.mjs && node scripts/generate-rss.mjs",
    "snapshot": "SNAPSHOT_API_URL=https://api.joey-haas.dev node scripts/fetch-snapshot.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "shots": "playwright test -c playwright.shots.config.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.1"
  },
  "overrides": {
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@shikijs/rehype": "^4.4.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "4.14.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exifr": "7.1.3",
    "globals": "^17.11.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "0.35.5",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  }
}
